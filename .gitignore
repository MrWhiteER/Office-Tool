__pycache__/
*.pyc
_cs_cache/
_cs_draft/
_cs_import/
config.json
drafts/

# Real business data this app writes at runtime — never belongs in a repo
# that might end up public (see engine.py's DATA_BASE comment for how the
# app locates these next to itself; nothing here is needed to build/run
# the app from source).
clients/
finance/
submissions/
# Every generated/synced document (Quotations, Invoices, DOs, Datasheets,
# Expense Reports...) — folder_for()'s own auto-managed local mirror of the
# shared R2 bucket (see app.py's CLOUD_DOCS_BASE comment). Confirmed real
# customer data lands here just from a dev checkout's own background sync
# thread pulling down whatever any real user generates — never belonged
# in git, same reasoning as clients/finance/submissions above; just missed
# when those were added.
cloud_documents/

# Login session-signing key (accounts.py/app.py) — a real secret, must
# never be committed. Accounts now sync via the same private Cloudflare
# R2 bucket photo_store.py uses (see accounts.py) — accounts.json/
# accounts_cache.json never belong in git at all, this repo included.
secret_key.txt
accounts.json
accounts_cache.json
accounts_dirty.flag
r2_readonly.json
google_oauth.json

# PyInstaller / installer build output — regenerated by build.bat, not
# source. See build.bat / installer.iss.
build/
dist/

# The actual Chromium browser bundled into the installer for PDF/preview
# rendering (see html_engine.py's _get_browser()) — copied in by build.bat
# from this machine's own `playwright install chromium` cache, not source,
# and far too large (400MB+) for git regardless. installer_output/'s own
# .exe is the real, shippable artifact; this is just a build-time input.
bundled_browser/
_internal/
installer_output/

# runtime_manager.py's own local cache (engine.DATA_BASE/runtime/) — where
# a dev checkout's Chromium ends up after the one-time legacy migration
# (see _migrate_legacy_runtime()), same "not source, just local runtime
# state" category as bundled_browser/ above.
runtime/
*.spec
*.exe

# app.py's local disk cache for /api/photostore-fetch — real downloaded
# photo bytes, not source, same "local runtime state" category as
# runtime/ above. See _PHOTO_CACHE_DIR's own comment.
photo_cache/

# Inno Setup uninstaller + update_checker.py's own /LOG= file — only ever
# appear here if an installer was ever run with this dev checkout as its
# /DIR= target (engine.DATA_BASE for `python app.py` IS the project root)
# — runtime artifacts, not source, same as everything else in this section.
unins*.dat
last_update_install.log

# WebView2's persistent cookie/session storage (see app.py's webview.start()
# call) — runtime browser profile data, not source.
webview_data/
