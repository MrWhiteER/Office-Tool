__pycache__/
*.pyc
_cs_cache/
_cs_draft/
_cs_import/
config.json
drafts/

# Real business data this app writes at runtime — never belongs in a repo
# that might end up public (see engine.py's DATA_BASE comment for how the
# app locates these next to itself; nothing here is needed to build/run
# the app from source).
clients/
finance/
submissions/

# Login session-signing key (accounts.py/app.py) — a real secret, must
# never be committed. Accounts now sync via the same private Cloudflare
# R2 bucket photo_store.py uses (see accounts.py) — accounts.json/
# accounts_cache.json never belong in git at all, this repo included.
secret_key.txt
accounts.json
accounts_cache.json
accounts_dirty.flag
r2_readonly.json

# PyInstaller / installer build output — regenerated by build.bat, not
# source. See build.bat / installer.iss.
build/
dist/
_internal/
installer_output/
*.spec
*.exe

# WebView2's persistent cookie/session storage (see app.py's webview.start()
# call) — runtime browser profile data, not source.
webview_data/
